@page
@model ContractsModel
@{ViewData["Title"]="فهرست قراردادها";}
<form method="get" class="search"><input asp-for="Q" placeholder="شماره، عنوان یا طرف قرارداد"/><select asp-for="Status"><option value="">همه وضعیت‌ها</option><option>پیش‌نویس</option><option>فعال</option><option>خاتمه‌یافته</option><option>لغوشده</option></select><button>جست‌وجو</button><a class="button" asp-page="/Edit">+ قرارداد جدید</a></form><section class="table"><table><thead><tr><th>شماره</th><th>عنوان / طرف قرارداد</th><th>مبلغ (ریال)</th><th>تاریخ پایان</th><th>وضعیت</th></tr></thead><tbody>@foreach(var c in Model.Items){<tr><td><a asp-page="/Details" asp-route-id="@c.Id">@c.Number</a></td><td>@c.Title<small>@c.Party</small></td><td>@c.Amount.ToString("N0")</td><td>@Shamsi.Format(c.EndDate)</td><td><span class="badge">@c.Status</span></td></tr>}</tbody></table>@if(Model.Items.Count==0){<p>قراردادی یافت نشد.</p>}<p>صفحه @Model.P — @Model.Total نتیجه</p>@if(Model.P>1){<a asp-route-p="@(Model.P-1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status">قبلی</a>} @if(Model.P*25<Model.Total){<a asp-route-p="@(Model.P+1)" asp-route-q="@Model.Q" asp-route-status="@Model.Status">بعدی</a>}</section>