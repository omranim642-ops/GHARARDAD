<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] | قرارداد</title><link rel="stylesheet" href="~/site.css"/></head><body><aside><h1>قرارداد</h1><p>سامانه مدیریت قراردادها</p><nav><a asp-page="/Index">نمای کلی</a><h3>مدیریت</h3><a asp-page="/Contracts">فهرست قراردادها</a><a asp-page="/Edit">تعریف قرارداد</a></nav>@if(User.Identity?.IsAuthenticated == true){<form method="post" asp-page="/Login" asp-page-handler="Logout"><button>خروج از حساب</button></form>}</aside><main><header><span>مدیریت و پیگیری قراردادها</span><span>@Shamsi.Format(DateTime.Today)</span></header><h1>@ViewData["Title"]</h1>@RenderBody()</main><script src="/calendar.js" defer></script></body></html>