@page
@model ChangePasswordModel
@{ViewData["Title"]="تغییر رمز مدیر";}
<section><p>در اولین ورود باید رمز اولیه را تغییر دهید. رمز جدید حداقل ۱۲ نویسه، شامل حرف کوچک، حرف بزرگ و عدد باشد.</p><form method="post"><div asp-validation-summary="All"></div><label>رمز فعلی<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required/></label><label>رمز جدید<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" required/></label><label>تکرار رمز جدید<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required/></label><button>ثبت رمز جدید</button></form></section>