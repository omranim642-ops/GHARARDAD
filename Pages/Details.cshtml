@page "{id:int}"
@model DetailsModel
@{ViewData["Title"]=Model.Item.Title;}
<section><div class="actions"><a class="button" asp-page="/Edit" asp-route-id="@Model.Item.Id">ویرایش قرارداد</a><a asp-page="/Print" asp-route-id="@Model.Item.Id">نسخه چاپی</a></div><dl><dt>شماره قرارداد</dt><dd>@Model.Item.Number</dd><dt>طرف قرارداد</dt><dd>@Model.Item.Party</dd><dt>مبلغ</dt><dd>@Model.Item.Amount.ToString("N0") ریال</dd><dt>بازه اعتبار</dt><dd>@Shamsi.Format(Model.Item.StartDate) تا @Shamsi.Format(Model.Item.EndDate)</dd><dt>وضعیت</dt><dd>@Model.Item.Status</dd><dt>توضیحات</dt><dd class="notes">@Model.Item.Notes</dd></dl></section><section><h2>پیوست‌ها</h2><div asp-validation-summary="All"></div>@foreach(var a in Model.Item.Attachments){<div class="attachment"><a asp-page-handler="Download" asp-route-id="@Model.Item.Id" asp-route-fileId="@a.Id">@a.Name</a><form method="post" asp-page-handler="Remove" asp-route-fileId="@a.Id"><button class="danger">حذف پیوست</button></form></div>}<form method="post" enctype="multipart/form-data"><label>افزودن فایل (PDF، تصویر یا Office؛ حداکثر ۱۰ مگابایت)<input type="file" asp-for="Upload" accept=".pdf,.png,.jpg,.jpeg,.docx,.xlsx" required/></label><button>بارگذاری پیوست</button></form></section>