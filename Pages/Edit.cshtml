@page "{id:int?}"
@model EditModel
@{ViewData["Title"]=Model.Input.Id==0?"تعریف قرارداد":"ویرایش قرارداد";}
<section><form method="post"><div asp-validation-summary="All"></div><input asp-for="Input.Id" type="hidden"/><div class="grid"><label>شماره قرارداد<input asp-for="Input.Number" required maxlength="100"/></label><label>عنوان قرارداد<input asp-for="Input.Title" required maxlength="250"/></label><label>طرف قرارداد<input asp-for="Input.Party" required maxlength="250"/></label><label>مبلغ (ریال)<input asp-for="Input.Amount" type="number" min="0" max="999999999999999" step="1"/></label><label>تاریخ شروع شمسی<input asp-for="Start" placeholder="1405/01/01" required/></label><label>تاریخ پایان شمسی<input asp-for="End" placeholder="1405/12/29" required/></label><label>وضعیت<select asp-for="Input.Status"><option>پیش‌نویس</option><option>فعال</option><option>خاتمه‌یافته</option><option>لغوشده</option></select></label></div><label>توضیحات<textarea asp-for="Input.Notes" rows="5" maxlength="4000"></textarea></label><button>ذخیره قرارداد</button> <a asp-page="/Contracts">بازگشت</a></form></section>